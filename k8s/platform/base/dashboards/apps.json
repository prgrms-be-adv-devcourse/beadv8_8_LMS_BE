        "query": {
          "query": "label_values(jvm_info, app_kubernetes_io_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery",
          "qryType": 5
        },
        "definition": "label_values(jvm_info, app_kubernetes_io_name)",
        "refresh": 2,
        "regex": "",
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
