  "panels": [
    {
      "type": "table",
      "title": "앱별 요약",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (app_kubernetes_io_name) (up{app_kubernetes_io_name=~\"$app\"})",
          "refId": "A",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "min by (app_kubernetes_io_name) (process_uptime_seconds{app_kubernetes_io_name=~\"$app\"})",
          "refId": "B",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app_kubernetes_io_name) (jvm_memory_used_bytes{app_kubernetes_io_name=~\"$app\", area=\"heap\"}) / sum by (app_kubernetes_io_name) (jvm_memory_max_bytes{app_kubernetes_io_name=~\"$app\", area=\"heap\"} > 0)",
          "refId": "C",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (app_kubernetes_io_name) (label_replace(max by (pod) (container_memory_working_set_bytes{pod=~\"${app}-.*\", container=\"app\"}) / max by (pod) (container_spec_memory_limit_bytes{pod=~\"${app}-.*\", container=\"app\"} > 0), \"app_kubernetes_io_name\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+\"))",
          "refId": "D",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (app_kubernetes_io_name) (label_replace(max by (pod) (max_over_time(container_memory_working_set_bytes{pod=~\"${app}-.*\", container=\"app\"}[$__range])) / max by (pod) (max_over_time(container_spec_memory_limit_bytes{pod=~\"${app}-.*\", container=\"app\"}[$__range]) > 0), \"app_kubernetes_io_name\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+\"))",
          "refId": "E",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (app_kubernetes_io_name) (increase(http_server_requests_seconds_count{app_kubernetes_io_name=~\"$app\", uri!~\"/actuator.*\"}[$__range])))",
          "refId": "F",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "(sum by (app_kubernetes_io_name) (increase(http_server_requests_seconds_count{app_kubernetes_io_name=~\"$app\", uri!~\"/actuator.*\", status=~\"5..\"}[$__range])) or sum by (app_kubernetes_io_name) (increase(http_server_requests_seconds_count{app_kubernetes_io_name=~\"$app\", uri!~\"/actuator.*\"}[$__range])) * 0) / (sum by (app_kubernetes_io_name) (increase(http_server_requests_seconds_count{app_kubernetes_io_name=~\"$app\", uri!~\"/actuator.*\"}[$__range])) > 0)",
          "refId": "G",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app_kubernetes_io_name) (increase(http_server_requests_seconds_sum{app_kubernetes_io_name=~\"$app\", uri!~\"/actuator.*\"}[$__range])) / (sum by (app_kubernetes_io_name) (increase(http_server_requests_seconds_count{app_kubernetes_io_name=~\"$app\", uri!~\"/actuator.*\"}[$__range])) > 0)",
          "refId": "H",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (app_kubernetes_io_name) (max_over_time(http_server_requests_seconds_max{app_kubernetes_io_name=~\"$app\", uri!~\"/actuator.*\"}[$__range]))",
          "refId": "I",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app_kubernetes_io_name) (increase(jvm_gc_pause_seconds_sum{app_kubernetes_io_name=~\"$app\"}[$__range])) / $__range_s",
          "refId": "J",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "max by (app_kubernetes_io_name) (max_over_time(hikaricp_connections_pending{app_kubernetes_io_name=~\"$app\"}[$__range]))",
          "refId": "K",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (app_kubernetes_io_name) (increase(hikaricp_connections_timeout_total{app_kubernetes_io_name=~\"$app\"}[$__range])))",
          "refId": "L",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "round(sum by (app_kubernetes_io_name) (increase(logback_events_total{app_kubernetes_io_name=~\"$app\", level=\"error\"}[$__range])))",
          "refId": "M",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app_kubernetes_io_name) (resilience4j_circuitbreaker_state{app_kubernetes_io_name=~\"$app\", state=~\"open|half_open|forced_open\"})",
          "refId": "N",
          "legendFormat": "__auto",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
