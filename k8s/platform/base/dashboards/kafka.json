{
  "uid": "hapbang-kafka",
  "title": "Kafka",
  "description": "앱이 내보내는 Kafka client·Spring Kafka 지표. broker exporter가 없어 broker 쪽 lag는 볼 수 없고, consumer가 멈추면 그 그룹의 lag series가 사라진다.",
  "tags": [
    "hapbang"
  ],
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "fiscalYearStartMonth": 0,
  "liveNow": false,
  "schemaVersion": 41,
  "version": 1,
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "hapbang"
      ],
      "asDropdown": false,
      "title": "합방 dashboard",
      "includeVars": false,
      "keepTime": true,
      "icon": "external link",
      "targetBlank": false
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
