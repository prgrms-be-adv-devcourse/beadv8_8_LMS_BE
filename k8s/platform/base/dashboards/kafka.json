    {
      "type": "timeseries",
      "title": "소비 그룹·토픽별 lag",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (group, topic) (label_replace(kafka_consumer_fetch_manager_records_lag{topic=~\".+\\\\..+\"}, \"group\", \"$1\", \"client_id\", \"consumer-(.+)-[0-9]+\"))",
          "refId": "A",
          "legendFormat": "{{group}} ← {{topic}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "partition lag 합계(kafka_consumer_fetch_manager_records_lag). 계속 늘면 소비가 발행을 따라가지 못하는 것이다",
      "id": 8,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "소비 그룹별 소비 건수",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (group) (label_replace(rate(kafka_consumer_fetch_manager_records_consumed_total{topic=~\".+\\\\..+\"}[$__rate_interval]), \"group\", \"$1\", \"client_id\", \"consumer-(.+)-[0-9]+\")) * 60",
          "refId": "A",
          "legendFormat": "{{group}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "poll로 가져온 레코드 수(분당)",
      "id": 9,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 6
      }
    },
    {
      "type": "timeseries",
      "title": "listener 처리 결과",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app_kubernetes_io_name, messaging_kafka_consumer_group, error) (rate(spring_kafka_listener_seconds_count[$__rate_interval])) * 60",
          "refId": "A",
          "legendFormat": "{{app_kubernetes_io_name}} {{messaging_kafka_consumer_group}} {{error}}",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "cpm",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 40,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".* failure .*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [],
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "listener 호출 결과(분당), 소비 그룹별. error가 none이면 성공이고, 실패는 예외 클래스 이름이다. 실패는 재시도마다 한 번씩 센다. Kafka observation(#630)이 만든 지표라 error 태그를 쓴다",
      "id": 10,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 14
      }
