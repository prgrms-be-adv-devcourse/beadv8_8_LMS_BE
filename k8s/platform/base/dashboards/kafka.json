    {
      "type": "timeseries",
      "title": "listener 처리 시간",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (app_kubernetes_io_name) (rate(spring_kafka_listener_seconds_sum[$__rate_interval])) / sum by (app_kubernetes_io_name) (rate(spring_kafka_listener_seconds_count[$__rate_interval]))",
