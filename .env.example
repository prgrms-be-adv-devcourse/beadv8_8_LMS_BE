# 앱(Spring)용 로컬 환경 변수 예시
# 사용법: cp .env.example .env 후 값 채우기 (.env는 git에 올리지 않는다)
# DB 접속 정보는 docker/.env 에서 관리한다

# 구글 OAuth (Google Cloud Console > Google Auth Platform > 클라이언트)
# 리디렉션 URI: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 치지직 Open API — 채널 인증용 (치지직 개발자 센터 > 애플리케이션)
# 권한: 유저 정보 조회, 채널 정보 조회
# 리디렉션 URL: http://localhost:8080/api/v1/members/channels/chzzk/callback (F4에서 확정)
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=
