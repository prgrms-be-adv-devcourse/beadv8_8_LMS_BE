# 앱(Spring)용 로컬 환경 변수 예시
# 사용법: cp .env.example .env 후 값 채우기 (.env는 git에 올리지 않는다)
# DB 접속 정보는 docker/.env 에서 관리한다

# 구글 OAuth (Google Cloud Console > Google Auth Platform > 클라이언트)
# 리디렉션 URI: http://localhost:8080/api/v1/members/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# 치지직 Open API — 채널 인증용 (치지직 개발자 센터 > 애플리케이션)
# 권한: 유저 정보 조회, 채널 정보 조회
# 리디렉션 URL: http://localhost:8080/api/v1/members/channels/chzzk/callback (로컬 앱에 등록, 로컬은 이 값으로 고정)
CHZZK_CLIENT_ID=
CHZZK_CLIENT_SECRET=

# HP 충전 — TossPayments 테스트 결제 (#224). 비워 두면 앱은 뜨고 충전 API만 503
# 토스페이먼츠 개발자센터 > API 키 > 테스트 시크릿 키 (test_sk_… / 결제위젯은 test_gsk_…). 클라이언트 키는 프론트엔드에 둔다
TOSS_PAYMENTS_SECRET_KEY=
# 결제키 암호화(AES-256)·중복 식별(HMAC) 키. 서로 다른 32바이트 값을 Base64로: openssl rand -base64 32
BILLING_PAYMENT_KEY_ENCRYPTION_KEY=
BILLING_PAYMENT_KEY_HMAC_KEY=
