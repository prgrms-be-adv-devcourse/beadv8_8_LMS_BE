<mxfile host="drawio"><diagram id="hapbang-notification-pipeline" name="알림 파이프라인"><mxGraphModel grid="0" page="0" background="#F3F3F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="알림: 여러 앱의 이벤트를 알림으로, 실시간 전달은 저장을 막지 않게" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1080" height="32" as="geometry"/></mxCell><mxCell id="h1" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;① 소비&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;토픽마다 리스너 하나" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="400" height="24" as="geometry"/></mxCell><mxCell id="h2" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;② 알림 만들기&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;53종" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="440" y="60" width="240" height="24" as="geometry"/></mxCell><mxCell id="h3" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;③ 저장&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;트랜잭션 하나" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="60" width="380" height="24" as="geometry"/></mxCell><mxCell id="h4" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;④ 실시간 전달&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;저장 트랜잭션 밖에서" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="476" width="500" height="24" as="geometry"/></mxCell><mxCell id