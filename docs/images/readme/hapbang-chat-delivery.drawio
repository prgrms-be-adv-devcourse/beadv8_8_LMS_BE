<mxfile host="drawio"><diagram id="hapbang-chat-delivery" name="채팅 전달"><mxGraphModel grid="0" page="0" background="#F3F3F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="채팅 전달: PostgreSQL outbox → Redis Streams → Pub/Sub → STOMP" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="chat-app 한 앱 안의 전달 경로. 원본은 PostgreSQL이고 Redis는 전달 버퍼다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="700" height="20" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:16px&quot;&gt;① 채팅 메시지 저장&lt;/b&gt;&lt;br&gt;메시지·outbox·&lt;br&gt;발행 체크포인트를&lt;br&gt;한 트랜잭션에 COMMIT&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;PostgreSQL&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="112" width="160" height="128" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:16px&quot;&gt;② outbox relay&lt;/b&gt;&lt;br&gt;처리권(lease)으로&lt;br&gt;행을 선점·커밋한 뒤&lt;br&gt;트랜잭션 밖에서 XADD&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;PostgreSQL → Redis&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="184" y="112" width="160" height="128" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:16px&quot;&gt;③ Stream 소비&lt;/b&gt;&lt;br&gt;consumer group으로&lt;br&gt;XREADGROUP&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;Redis Streams&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="368" y="112" width="160" height="128" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:16px&quot;&gt;④ Pub/Sub 발행&lt;/b&gt;&lt;br&gt;서버 채널·방 채널에&lt;br&gt;PUBLISH&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;Redis Pub/Sub&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="552" y="112" width="160" height="128" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b style=&quot;font-size:16px&quot;&gt;⑤ 체크포인트 커밋&lt;/b&gt;&lt;br&gt;PUBLISHED로&lt;br&gt;커밋한 뒤에만&lt;br&gt;XACK&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;PostgreSQL → Redis&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="736" y="112" width="160" height="128" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b style=&quot;font-size:16px&quot;&gt;⑥ 브라우저로 전달&lt;/b&gt;&lt;br&gt;Pub/Sub 리스너가 받아&lt;br&gt;방 topic 구독 연결에&lt;br&gt;로컬 STOMP로 보냄&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;WebSocket&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="920" y="112" width="160" height="128" as="geometry"/></mxCell><mxCell id="e-s1-s2" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-s2-s3" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-s3-s4" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-s4-s5" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-s4-s6" value="Pub/Sub 구독" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="632.0" y="86"/><mxPoint x="1000.0" y="86"/></Array></mxGeometry></mxCell><mxCell id="b-a-h" value="" style="html=1;rounded=0;strokeColor=#C2410C;strokeWidth=1.5;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="80.0" y="240" as="sourcePoint"/><mxPoint x="264.0" y="240" as="targetPoint"/><Array as="points"><mxPoint x="80.0" y="256"/><mxPoint x="264.0" y="256"/></Array></mxGeometry></mxCell><mxCell id="b-a-v" value="" style="html=1;rounded=0;strokeColor=#C2410C;strokeWidth=1.5;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="172.0" y="256" as="sourcePoint"/><mxPoint x="172.0" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-b-h" value="" style="html=1;rounded=0;strokeColor=#C2410C;strokeWidth=1.5;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="448.0" y="240" as="sourcePoint"/><mxPoint x="632.0" y="240" as="targetPoint"/><Array as="points"><mxPoint x="448.0" y="256"/><mxPoint x="632.0" y="256"/></Array></mxGeometry></mxCell><mxCell id="b-b-v" value="" style="html=1;rounded=0;strokeColor=#C2410C;strokeWidth=1.5;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="540.0" y="256" as="sourcePoint"/><mxPoint x="540.0" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b-c-v" value="" style="html=1;rounded=0;strokeColor=#C2410C;strokeWidth=1.5;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="816.0" y="240" as="sourcePoint"/><mxPoint x="816.0" y="274" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c-outbox" value="&lt;b style=&quot;font-size:16px;color:#C2410C&quot;&gt;outbox&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1F2937&quot;&gt;DB 커밋과 Stream 적재 사이의 공백을 메운다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;XADD 전에 멈춰도 행이 남는다.&lt;br&gt;처리권이 만료되면 relay가 다시 적재한다.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="274" width="344" height="112" as="geometry"/></mxCell><mxCell id="c-pel" value="&lt;b style=&quot;font-size:16px;color:#C2410C&quot;&gt;PEL · XAUTOCLAIM&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1F2937&quot;&gt;소비 실패를 메운다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;읽고 멈추거나 발행에 실패한 항목은 XACK하지 않는다.&lt;br&gt;미확인 목록(PEL)을 회수 루프가 다시 처리한다.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="368" y="274" width="344" height="112" as="geometry"/></mxCell><mxCell id="c-reconstruct" value="&lt;b style=&quot;font-size:16px;color:#C2410C&quot;&gt;DB 체크포인트 대조&lt;/b&gt;&lt;br&gt;&lt;b style=&quot;color:#1F2937&quot;&gt;Redis 데이터 유실을 메운다&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;체크포인트가 아직 PENDING인 작업을 Stream과&lt;br&gt;대조해, 처리될 수 없으면 같은 ID로 다시 XADD한다.&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=10;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="736" y="274" width="344" height="112" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;Redis가 멈추거나 데이터를 잃어도 메시지는 DB에 남고, 발행되지 않은 작업은 다시 발행된다&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=19;fontColor=#065F46;" vertex="1" parent="1"><mxGeometry x="0" y="416" width="1080" height="60" as="geometry"/></mxCell><mxCell id="note" value="발행 뒤 체크포인트 커밋 전에 멈추면 같은 메시지가 한 번 더 발행될 수 있다(중복 허용). 시도 상한을 넘긴 작업은 DEAD로 격리하고 운영 재처리로 다시 보낸다.&lt;br&gt;Pub/Sub은 놓친 구독자에게 다시 보내지 않는다. 브라우저가 놓친 메시지는 REST 이력 조회로 채운다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="490" width="1080" height="44" as="geometry"/></mxCell><mxCell id="ticket-panel" value="" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=6;fillColor=#F3F3F3;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="0" y="564" width="528" height="176" as="geometry"/></mxCell><mxCell id="ticket-title" value="&lt;b&gt;연결 티켓으로 WebSocket을 연다&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#1F2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="578" width="488" height="22" as="geometry"/></mxCell><mxCell id="ticket-why" value="브라우저는 WebSocket 연결 요청에 Authorization 헤더를 실을 수 없다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="604" width="488" height="20" as="geometry"/></mxCell><mxCell id="ticket-b1" value="&lt;b&gt;REST로 발급&lt;/b&gt;&lt;br&gt;30초 TTL로 Redis에 저장" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="636" width="204" height="62" as="geometry"/></mxCell><mxCell id="ticket-b2" value="&lt;b&gt;핸드셰이크에서 GETDEL&lt;/b&gt;&lt;br&gt;꺼내면서 지운다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="304" y="636" width="204" height="62" as="geometry"/></mxCell><mxCell id="ticket-e" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ticket-b1" target="ticket-b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ticket-note" value="한 번용: 같은 티켓으로 두 번 연결해도 한쪽만 성공한다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="706" width="488" height="20" as="geometry"/></mxCell><mxCell id="alert-panel" value="" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=6;fillColor=#F3F3F3;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=14;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="552" y="564" width="528" height="176" as="geometry"/></mxCell><mxCell id="alert-title" value="&lt;b&gt;알림 “채팅 전달 멈춤”&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#1F2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="572" y="578" width="488" height="22" as="geometry"/></mxCell><mxCell id="alert-why" value="Redis 연결·쓰기나 Pub/Sub 구독이 끊기면 전달을 멈춘다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="572" y="604" width="488" height="20" as="geometry"/></mxCell><mxCell id="alert-b1" value="&lt;b&gt;파이프라인 멈춤&lt;/b&gt;&lt;br&gt;작업은 outbox·PEL에 남음" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="572" y="636" width="204" height="62" as="geometry"/></mxCell><mxCell id="alert-b2" value="&lt;b&gt;5분 넘게 멈추면 알림&lt;/b&gt;&lt;br&gt;앱이 재확인해 다시 연다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="856" y="636" width="204" height="62" as="geometry"/></mxCell><mxCell id="alert-e" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="alert-b1" target="alert-b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="alert-note" value="멈춘 동안은 시도 횟수로 세지 않아, Redis 장애가 격리(DEAD)로 이어지지 않는다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="572" y="706" width="488" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
