<mxfile host="drawio"><diagram id="hapbang-appearance-hp-task" name="HP 작업은 기록하고, 끝까지 실패하면 격리한다"><mxGraphModel grid="0" page="0" background="#F3F3F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="HP 작업은 기록하고, 끝까지 실패하면 격리한다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="700" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="출연 DB와 지갑 DB가 달라 한 트랜잭션으로 묶을 수 없다. 지갑 호출은 순간 장애·결과 불명·커밋 직후 서버 종료로 실패할 수 있다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="40" width="1080" height="22" as="geometry"/></mxCell><mxCell id="tx" value="" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="177" width="196" height="246" as="geometry"/></mxCell><mxCell id="tx-head" value="한 트랜잭션" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="189" width="196" height="22" as="geometry"/></mxCell><mxCell id="tx-state" value="&lt;b&gt;출연 상태 변경&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;거절·취소·마감·확인 등&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="14" y="221" width="168" height="70" as="geometry"/></mxCell><mxCell id="tx-task" value="&lt;b&gt;HP 작업 PENDING 저장&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;멱등 키 = 지갑 요청 ID&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="14" y="303" width="168" height="70" as="geometry"/></mxCell><mxCell id="tx-commit" value="COMMIT" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="387" width="196" height="22" as="geometry"/></mxCell><mxCell id="tx-cap" value="커밋 직후 서버가 죽어도&lt;br&gt;할 일이 남는다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="431" width="196" height="34" as="geometry"/></mxCell><mxCell id="call" value="&lt;b style=&quot;font-size:17px&quot;&gt;지갑 내부 API&lt;br&gt;호출&lt;/b&gt;&lt;br&gt;&lt;br&gt;트랜잭션 밖에서&lt;br&gt;반환·지급·위약금&lt;br&gt;같은 요청 ID로" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=8;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="252" y="100" width="176" height="400" as="geometry"/></mxCell><mxCell id="done" value="&lt;b style=&quot;font-size:16px;color:#065F46&quot;&gt;DONE&lt;/b&gt;&amp;nbsp;&amp;nbsp;완료&lt;br&gt;지갑 처리 완료. 응답을 잃어 다시 보내도 지갑은 처음 결과를 돌려준다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="578" y="100" width="502" height="80" as="geometry"/></mxCell><mxCell id="pending" value="&lt;b style=&quot;font-size:16px;color:#92400E&quot;&gt;PENDING&lt;/b&gt;&amp;nbsp;&amp;nbsp;재시도 대기&lt;br&gt;1분 → 2분 → 4분 … 최대 1시간&lt;br&gt;지터 +0~20%, 최대 10회 시도&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;회로가 열려 보내지 못하면&lt;br&gt;시도 횟수에 넣지 않는다&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="578" y="220" width="248" height="132" as="geometry"/></mxCell><mxCell id="dead" value="&lt;b style=&quot;font-size:16px;color:#B91C1C&quot;&gt;DEAD&lt;/b&gt;&amp;nbsp;&amp;nbsp;격리&lt;br&gt;자동 실행을 멈춘다&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;[HP_TASK_DEAD] 오류 로그&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="578" y="404" width="248" height="96" as="geometry"/></mxCell><mxCell id="alert" value="&lt;b style=&quot;font-size:16px&quot;&gt;Grafana alert&lt;/b&gt;&lt;br&gt;&lt;b&gt;HP 작업 DEAD&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B;font-size:13px&quot;&gt;DEAD 작업이 있으면 즉시&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="404" width="210" height="96" as="geometry"/></mxCell><mxCell id="admin" value="&lt;b style=&quot;font-size:16px&quot;&gt;관리자 다시 시도&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#475569;font-size:13px&quot;&gt;POST …/{taskId}/retry&lt;/span&gt;&lt;br&gt;PENDING, 시도 횟수 0&lt;br&gt;같은 멱등 키로 바로 실행" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="870" y="220" width="210" height="132" as="geometry"/></mxCell><mxCell id="e-tx-call" value="커밋 뒤" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tx" target="call"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-done" value="성공" style="html=1;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#065F46;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="call" target="done"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pend" value="결과를 받지 못함" style="html=1;rounded=0;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#92400E;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.395;exitDx=0;exitDy=0;entryX=0;entryY=0.2879;entryDx=0;entryDy=0;" edge="1" parent="1" source="call" target="pending"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-retry" value="재시도 배치" style="html=1;rounded=0;strokeColor=#D97706;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#92400E;labelBackgroundColor=#F3F3F3;exitX=0;exitY=0.697;exitDx=0;exitDy=0;entryX=1;entryY=0.53;entryDx=0;entryDy=0;" edge="1" parent="1" source="pending" target="call"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="retry-why" value="다음 시도 시각이&lt;br&gt;지난 작업을 매분" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="432" y="324" width="142" height="34" as="geometry"/></mxCell><mxCell id="e-dead" value="지갑이 거절" style="html=1;rounded=0;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#B91C1C;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.88;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="call" target="dead"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="dead-why" value="다시 보내도&lt;br&gt;같은 결과" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="432" y="464.0" width="142" height="34" as="geometry"/></mxCell><mxCell id="e-exhaust" value="10회째 실패" style="html=1;rounded=0;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#B91C1C;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="pending" target="dead"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-alert" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="dead" target="alert"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-admin" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="alert" target="admin"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-reopen" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="admin" target="pending"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="recon" value="" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=6;fillColor=#FFFFFF;strokeColor=#CBD5E1;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="548" width="1080" height="152" as="geometry"/></mxCell><mxCell id="recon-head" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;매일 서비스 간 HP 대사&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;04:00:25 KST · 규칙 11종 · 고치지 않고 어긋난 건을 알린다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="20" y="564" width="1040" height="24" as="geometry"/></mxCell><mxCell id="r-state" value="&lt;b&gt;출연 상태&lt;/b&gt;&lt;br&gt;요청서·모집글·출연" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20.0" y="608" width="168" height="64" as="geometry"/></mxCell><mxCell id="r-task" value="&lt;b&gt;끝난 HP 작업의 합&lt;/b&gt;&lt;br&gt;DONE 반환·지급" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="298.6666666666667" y="608" width="168" height="64" as="geometry"/></mxCell><mxCell id="r-wallet" value="&lt;b&gt;지갑 보류·지급&lt;/b&gt;&lt;br&gt;지갑 내부 API로 조회" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="577.3333333333334" y="608" width="168" height="64" as="geometry"/></mxCell><mxCell id="r-alert" value="&lt;b style=&quot;font-size:16px&quot;&gt;Grafana alert&lt;/b&gt;&lt;br&gt;&lt;b&gt;서비스 간 HP 대사 불일치&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="856.0" y="608" width="204" height="64" as="geometry"/></mxCell><mxCell id="r-c1" value="① 비교" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;startArrow=block;startFill=1;startSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-state" target="r-task"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-c2" value="② 비교" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;startArrow=block;startFill=1;startSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-task" target="r-wallet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-c3" value="어긋나면" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-wallet" target="r-alert"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-c1-why" value="출연 쪽&lt;br&gt;기록 누락" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="192.0" y="650.0" width="102.66666666666667" height="34" as="geometry"/></mxCell><mxCell id="r-c2-why" value="지갑 쪽 반영&lt;br&gt;누락·중복" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="470.6666666666667" y="650.0" width="102.66666666666667" height="34" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;실패해도 HP가 사라지거나 두 번 움직이지 않는다&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=19;fontColor=#065F46;spacing=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="0" y="728" width="1080" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
