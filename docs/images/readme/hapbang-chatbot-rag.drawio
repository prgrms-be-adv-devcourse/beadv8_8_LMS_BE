<mxfile host="drawio"><diagram id="hapbang-chatbot-rag" name="챗봇 RAG"><mxGraphModel grid="0" page="0" background="#F3F3F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="챗봇: 벡터 검색 + LLM 리랭킹 + Tool Calling, 장애에도 답한다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1060" height="32" as="geometry"/></mxCell><mxCell id="lane-a" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;데이터 준비&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;글 해시가 바뀐 것만 다시 임베딩해 색인" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="50" width="700" height="24" as="geometry"/></mxCell><mxCell id="a-faq" value="&lt;b style=&quot;font-size:16px&quot;&gt;FAQ 시드 53건&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;faq-seed.json&lt;/span&gt; · 분류 11개" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="88" width="270" height="58" as="geometry"/></mxCell><mxCell id="a-copy" value="&lt;b style=&quot;font-size:16px&quot;&gt;강의·인플루언서 사본&lt;/b&gt;&lt;br&gt;다른 앱 Kafka 이벤트 + 매시 내부 API 싱크" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="160" width="270" height="58" as="geometry"/></mxCell><mxCell id="a-embed" value="&lt;b style=&quot;font-size:16px&quot;&gt;임베딩&lt;/b&gt;&lt;br&gt;글을 벡터로" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="340" y="115" width="190" height="76" as="geometry"/></mxCell><mxCell id="a-embed-cap" value="FaqIndexer · IndexTaskRunner" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="310" y="195" width="250" height="18" as="geometry"/></mxCell><mxCell id="a-es" value="&lt;b style=&quot;font-size:17px&quot;&gt;Elasticsearch &lt;span style=&quot;font-family:Wanted Sans&quot;&gt;dense_vector&lt;/span&gt;&lt;/b&gt;&lt;br&gt;HNSW · cosine · 양자화 없음&lt;br&gt;index 3개: FAQ · 강의 · 인플루언서&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;이름에 공급자·차원: chatbot-&amp;lt;종류&amp;gt;-&amp;lt;공급자&amp;gt;-&amp;lt;차원&amp;gt;&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=14;fontColor=#1E3A8A;spacing=6;" vertex="1" parent="1"><mxGeometry x="600" y="88" width="460" height="130" as="geometry"/></mxCell><mxCell id="a-es-cap" value="FaqVectorIndex · RecommendVectorIndex" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="600" y="222" width="460" height="18" as="geometry"/></mxCell><mxCell id="e-a-faq" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.0263;entryDx=0;entryDy=0;" edge="1" parent="1" source="a-faq" target="a-embed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-a-copy" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.9737;entryDx=0;entryDy=0;" edge="1" parent="1" source="a-copy" target="a-embed"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-a-es" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a-embed" target="a-es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lane-b" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;질문 처리&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;경로는 /api/v1/chatbot 뒤만 적었다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="268" width="700" height="24" as="geometry"/></mxCell><mxCell id="member" value="&lt;b style=&quot;font-size:16px&quot;&gt;로그인 회원 (챗봇 화면)&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#64748B&quot;&gt;대화는 서버에 저장하지 않는다. 자유 질문은 FE가 요청마다 history를 보낸다&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="304" width="1060" height="52" as="geometry"/></mxCell><mxCell id="e-faq" value="&lt;b style=&quot;font-size:16px&quot;&gt;FAQ 대화&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;POST /chat/faq&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;POST /chat/faq/stream&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="408" width="280" height="82" as="geometry"/></mxCell><mxCell id="e-rec" value="&lt;b style=&quot;font-size:16px&quot;&gt;강의·인플루언서 추천받기&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;POST /recommendations/lectures/explained&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;POST …/influencers/explained&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="390" y="408" width="280" height="82" as="geometry"/></mxCell><mxCell id="e-chat" value="&lt;b style=&quot;font-size:16px&quot;&gt;자유 질문&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;POST /messages · /messages/stream&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;{message, history}&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="408" width="280" height="82" as="geometry"/></mxCell><mxCell id="m-req-0" value="질문" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=0.0943;exitY=1;exitDx=0;exitDy=0;entryX=0.2857;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="member" target="e-faq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-res-0" value="SSE 스트림" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=0.7143;exitY=0;exitDx=0;exitDy=0;entryX=0.2075;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="e-faq" target="member"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="m-req-1" value="질문" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;