l id="guard" value="" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=6;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=2;fontSize=14;" vertex="1" parent="1"><mxGeometry x="0" y="652" width="1060" height="148" as="geometry"/></mxCell><mxCell id="guard-label" value="&lt;b style=&quot;font-size:17px;color:#5B21B6&quot;&gt;LlmCallGuard&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B21B6&quot;&gt;LLM 회로 1개 + 동시 호출 상한 4개를 모든 챗봇 기능이 함께 쓴다&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="220" y="762" width="620" height="26" as="geometry"/></mxCell><mxCell id="llm-faq" value="&lt;b style=&quot;font-size:16px&quot;&gt;LLM 답변&lt;/b&gt;&lt;br&gt;searchFaq 결과만 근거로&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;FaqChatUseCase&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="670" width="280" height="82" as="geometry"/></mxCell><mxCell id="llm-rec" value="&lt;b style=&quot;font-size:16px&quot;&gt;LLM 리랭킹&lt;/b&gt;&lt;br&gt;풀에서 5개를 골라 순서·이유&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;RecommendReranker&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="390" y="670" width="280" height="82" as="geometry"/></mxCell><mxCell id="llm-chat" value="&lt;b style=&quot;font-size:16px&quot;&gt;LLM Tool Calling&lt;/b&gt;&lt;br&gt;요청 하나에 Tool 최대 3번&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;ChatbotConversationUseCase&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="670" width="280" height="82" as="geometry"/></mxCell><mxCell id="f-faq-1" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e-faq" target="llm-faq"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-rec-1" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e-rec" target="rec-pool"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-rec-2" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="rec-pool" target="llm-rec"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="f-chat-1" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="e-chat" target="llm-chat"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="tool-faq" value="&lt;b style=&quot;font-size:16px&quot;&gt;searchFaq&lt;/b&gt;&lt;br&gt;FAQ index kNN, 기준값 이상만&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;FaqTools&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="840" width="280" height="82" as="geometry"/></mxCell><mxCell id="tool-chat" value="&lt;b style=&quot;font-size:16px&quot;&gt;Tool 3개&lt;/b&gt;&lt;br&gt;searchFaq · recommendLectures&lt;br&gt;recommendInfluencers" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="840" width="280" height="82" as="geometry"/></mxCell><mxCell id="rec-note" value="추천은 Tool 없이 코드가 먼저 검색하고&lt;br&gt;LLM은 그 풀 안에서만 고른다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="390" y="840" width="280" height="82" as="geometry"/></mxCell><mxCell id="t-faq" value="Tool 호출" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;startArrow=block;startFill=1;startSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="llm-faq" target="tool-faq"><mxGeometry x="0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t-chat" value="Tool 호출" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;startArrow=block;startFill=1;startSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="llm-chat" target="tool-chat"><mxGeometry x="0.55" relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lane-f" value="&lt;b style=&quot;font-size:17px;color:#C2410C&quot;&gt;LLM·ES 장애 때&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;liveness·readiness는 UP 유지. 회로 열림·동시 상한·시간 초과도 같은 답" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="956" width="1060" height="24" as="geometry"/></mxCell><mxCell id="f-faq" value="&lt;b style=&quot;font-size:16px&quot;&gt;FAQ 대화&lt;/b&gt;&lt;br&gt;FAQ 검색 상위 1건&lt;br&gt;또는 안내 문구, &lt;b&gt;fallback: true&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="20" y="994" width="280" height="96" as="geometry"/></mxCell><mxCell id="f-rec" value="&lt;b style=&quot;font-size:16px&quot;&gt;추천&lt;/b&gt;&lt;br&gt;LLM 실패: 코드 순서 5개 + 이유 코드 문장&lt;br&gt;검색 실패: 인기순 &lt;b&gt;POPULAR_TEMPORARY&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="390" y="994" width="280" height="96" as="geometry"/></mxCell><mxCell id="f-chat" value="&lt;b style=&quot;font-size:16px&quot;&gt;자유 질문&lt;/b&gt;&lt;br&gt;Tool이 만든 카드 + 정해진 문장&lt;br&gt;카드가 없으면 FAQ 상위 1건·안내 문구" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="760" y="994" width="280" height="96" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;오프라인 평가(더미 데이터): 인플루언서 추천 hit@5 0.188 → 0.225&lt;/b&gt;&lt;span style=&quot;font-size:15px&quot;&gt;&amp;nbsp;&amp;nbsp;같은 후보 풀의 코드 순서 → LLM 리랭킹&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=19;fontColor=#065F46;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="1126" width="1060" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
