<mxfile host="drawio"><diagram id="hapbang-search-reindex" name="검색 재색인과 보정"><mxGraphModel grid="0" page="0" background="#F3F3F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="검색: nori 한국어 분석, alias 무중단 재색인, 10분 보정" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="32" as="geometry"/></mxCell><mxCell id="h-analyzer" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;분석기&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;색인과 검색이 쓰는 nori 분석기" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="52" width="700" height="24" as="geometry"/></mxCell><mxCell id="lbl-index" value="&lt;b&gt;ko_index&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;색인&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#1F2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="90" width="86" height="48" as="geometry"/></mxCell><mxCell id="lbl-search" value="&lt;b&gt;ko_search&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;검색&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#1F2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="150" width="86" height="48" as="geometry"/></mxCell><mxCell id="tok" value="&lt;b&gt;nori_tokenizer&lt;/b&gt;&lt;br&gt;사용자 사전" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="100" y="90" width="176" height="48" as="geometry"/></mxCell><mxCell id="pos" value="&lt;b&gt;nori_part_of_speech&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="304" y="90" width="190" height="48" as="geometry"/></mxCell><mxCell id="low" value="&lt;b&gt;lowercase&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="522" y="90" width="110" height="48" as="geometry"/></mxCell><mxCell id="e-tok-pos" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="tok" target="pos"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-pos-low" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="pos" target="low"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="same3" value="ko_index와 같은 세 단계" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#F3F3F3;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=14;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="100" y="150" width="532" height="48" as="geometry"/></mxCell><mxCell id="syn" value="&lt;b&gt;synonym_graph&lt;/b&gt;&lt;br&gt;Synonyms API 묶음, 갱신 가능" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="660" y="150" width="214" height="48" as="geometry"/></mxCell><mxCell id="e-same-syn" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="same3" target="syn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="hash" value="&lt;b style=&quot;font-size:16px&quot;&gt;설정 해시 12자&lt;/b&gt;&lt;br&gt;mapping·분석기·&lt;br&gt;사용자 사전으로 만든다.&lt;br&gt;동의어는 넣지 않아&lt;br&gt;바꿔도 재색인하지 않는다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="904" y="90" width="176" height="108" as="geometry"/></mxCell><mxCell id="files" value="사용자 사전 user-dictionary.txt · 동의어 synonyms.txt → ES Synonyms API 묶음 search-synonyms" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="100" y="206" width="760" height="18" as="geometry"/></mxCell><mxCell id="h-reindex" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;무중단 재색인&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;새 index를 다 채우고 확인한 뒤 alias만 옮긴다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="254" width="800" height="24" as="geometry"/></mxCell><mxCell id="check" value="&lt;b style=&quot;font-size:16px&quot;&gt;확인&lt;/b&gt;&lt;br&gt;기동 때 한 번, 그 뒤 10분마다&lt;br&gt;JobLock으로 pod 하나만&lt;br&gt;alias가 없거나 다른 해시면 시작" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="292" width="240" height="104" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:16px&quot;&gt;① 새 index 만들기&lt;/b&gt;&lt;br&gt;남은 index 지우고 시각 T 기록&lt;br&gt;search-influencers-&amp;lt;해시&amp;gt;를&lt;br&gt;alias 없이 생성" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="292" width="240" height="104" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:16px&quot;&gt;② 채우기&lt;/b&gt;&lt;br&gt;회원 목록을 500명씩 끝까지 bulk&lt;br&gt;정상 인플루언서는 보이는 문서,&lt;br&gt;그 밖의 회원은 숨김 문서" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="292" width="240" height="104" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:16px&quot;&gt;③ 문서 수 비교&lt;/b&gt;&lt;br&gt;refresh 뒤 넣은 보이는 문서 수와&lt;br&gt;새 index의 보이는 문서 수,&lt;br&gt;다르면 멈춤" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="292" width="240" height="104" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:16px&quot;&gt;④ alias 옮기기&lt;/b&gt;&lt;br&gt;search-influencers를&lt;br&gt;옛 index → 새 index로&lt;br&gt;한 요청(remove + add)" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="438" width="240" height="104" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b style=&quot;font-size:16px&quot;&gt;⑤ 따라잡기&lt;/b&gt;&lt;br&gt;T − 1분부터 증분 보정 한 번&lt;br&gt;재색인 중 옛 index로 간&lt;br&gt;변경을 새 index에 반영" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="560" y="438" width="240" height="104" as="geometry"/></mxCell><mxCell id="s6" value="&lt;b style=&quot;font-size:16px&quot;&gt;⑥ 옛 index 지움&lt;/b&gt;&lt;br&gt;못 지우면&lt;br&gt;다음 확인 때 지운다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="438" width="240" height="104" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b style=&quot;font-size:16px&quot;&gt;①~④ 실패하면&lt;/b&gt;&lt;br&gt;alias는 옛 그대로,&lt;br&gt;만들던 새 index 지움&lt;br&gt;다음 확인(10분 뒤)에 처음부터" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=14;fontColor=#B91C1C;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="438" width="240" height="104" as="geometry"/></mxCell><mxCell id="e-check-1" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="check" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-1-2" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-2-3" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-3-4" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-4-5" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-5-6" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s5" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-fail" value="" style="html=1;rounded=0;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="fail" target="check"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="reindex-cap" value="④ 전까지 검색·이벤트·보정은 옛 index를 쓴다. alias를 한 요청으로 옮겨 검색이 alias를 잃거나 두 index를 함께 보는 순간이 없다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="552" width="1080" height="18" as="geometry"/></mxCell><mxCell id="h-sync" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;증분 반영과 보정&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;회원 이벤트와 10분 증분 보정이 같은 apply를 부른다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="600" width="800" height="24" as="geometry"/></mxCell><mxCell id="kafka" value="&lt;b style=&quot;font-size:16px&quot;&gt;회원 이벤트&lt;/b&gt;&lt;br&gt;Kafka member.events.v1&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;가입·변경&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="638" width="240" height="84" as="geometry"/></mxCell><mxCell id="consume" value="&lt;b style=&quot;font-size:16px&quot;&gt;이벤트 소비&lt;/b&gt;&lt;br&gt;그룹 auxiliary-app.search-member&lt;br&gt;실패하면 1·2·4초 간격 재시도 3번" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="284" y="638" width="236" height="84" as="geometry"/></mxCell><mxCell id="dlt" value="&lt;b style=&quot;font-size:16px&quot;&gt;DLT&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;member.events.v1.auxiliary-app.&lt;br&gt;search-member.DLT&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=14;fontColor=#B91C1C;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="742" width="240" height="60" as="geometry"/></mxCell><mxCell id="changes" value="&lt;b style=&quot;font-size:16px&quot;&gt;회원 변경분 내부 API&lt;/b&gt;&lt;br&gt;커서 − 1분부터&lt;br&gt;500명씩 끝까지" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="826" width="240" height="84" as="geometry"/></mxCell><mxCell id="reconcile" value="&lt;b style=&quot;font-size:16px&quot;&gt;증분 보정&lt;/b&gt;&lt;br&gt;10분마다, JobLock으로 pod 하나만&lt;br&gt;페이지마다 커서 저장" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="284" y="826" width="236" height="84" as="geometry"/></mxCell><mxCell id="apply" value="&lt;b style=&quot;font-size:16px&quot;&gt;apply&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;InfluencerMemberIndexer&lt;/span&gt;&lt;br&gt;&lt;br&gt;정상 인플루언서면 보이기,&lt;br&gt;아니면 숨기기&lt;br&gt;&lt;br&gt;&lt;b&gt;회원 version 조건부 쓰기&lt;/b&gt;&lt;br&gt;painless scripted upsert로&lt;br&gt;들어온 version이 더 클 때만 반영,&lt;br&gt;늦거나 중복된 쓰기는 noop" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="564" y="638" width="266" height="272" as="geometry"/></mxCell><mxCell id="es" value="&lt;b style=&quot;font-size:16px&quot;&gt;ES&lt;/b&gt;&lt;br&gt;alias search-influencers&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;require_alias로&lt;br&gt;alias에만 쓴다&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="874" y="718.0" width="206" height="112" as="geometry"/></mxCell><mxCell id="e-kafka" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="kafka" target="consume"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-changes" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="changes" target="reconcile"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-consume-apply" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.1544;entryDx=0;entryDy=0;" edge="1" parent="1" source="consume" target="apply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-reconcile-apply" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8456;entryDx=0;entryDy=0;" edge="1" parent="1" source="reconcile" target="apply"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-apply-es" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apply" target="es"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-dlt" value="" style="html=1;rounded=0;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#B91C1C;labelBackgroundColor=#F3F3F3;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="consume" target="dlt"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="343.0" y="772.0"/></Array></mxGeometry></mxCell><mxCell id="dlt-why" value="ES가 약 7초 넘게&lt;br&gt;멈추면" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#B91C1C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="355.0" y="732" width="150" height="36" as="geometry"/></mxCell><mxCell id="sync-cap" value="DLT로 간 변경도 회원 변경분에 남아 다음 회차 보정이 같은 apply로 반영한다. 이벤트로 이미 반영한 회원은 version으로 걸러진다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="920" width="1080" height="18" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;검색을 멈추지 않고 재색인하고, 사람이 DLT를 되돌리지 않아도 다음 회차에 맞춰진다&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=19;fontColor=#065F46;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="956" width="1080" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
