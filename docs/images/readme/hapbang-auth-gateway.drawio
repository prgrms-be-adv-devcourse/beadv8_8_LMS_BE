<mxfile host="drawio"><diagram id="hapbang-auth-gateway" name="인증은 Gateway가, 인가는 앱이"><mxGraphModel grid="0" page="0" background="#F3F3F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="인증은 Gateway가, 인가는 앱이" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="600" height="32" as="geometry"/></mxCell><mxCell id="envoy" value="" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=4;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="170" y="60" width="430" height="312" as="geometry"/></mxCell><mxCell id="envoy-title" value="Envoy Gateway" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=17;fontColor=#1E3A8A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="70" width="300" height="24" as="geometry"/></mxCell><mxCell id="step1" value="&lt;b style=&quot;font-size:16px&quot;&gt;① 외부에서 온 헤더 제거&lt;/b&gt;&lt;br&gt;x-user-id · x-user-role · x-user-token-exp&lt;br&gt;x-internal-api-key&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;ClientTrafficPolicy earlyRequestHeaders.remove&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="190" y="104" width="390" height="94" as="geometry"/></mxCell><mxCell id="step2" value="&lt;b style=&quot;font-size:16px&quot;&gt;② JWT 서명 검증&lt;/b&gt;&lt;br&gt;토큰은 Authorization: Bearer에서만 읽는다&lt;br&gt;서명·만료·발급자 확인, 토큰이 없으면 그대로 통과&lt;br&gt;&lt;b&gt;sub → X-User-Id&lt;/b&gt; · &lt;b&gt;role → X-User-Role&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;SecurityPolicy remoteJWKS · claimToHeaders&lt;br&gt;chat·auxiliary는 exp → X-User-Token-Exp도&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="190" y="224" width="390" height="132" as="geometry"/></mxCell><mxCell id="np" value="" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=4;fillColor=none;strokeColor=#DC2626;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="140" width="440" height="338.0" as="geometry"/></mxCell><mxCell id="np-title" value="NetworkPolicy" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=15;fontColor=#DC2626;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="656" y="148" width="160" height="22" as="geometry"/></mxCell><mxCell id="np-rule" value="8080은 Envoy pod만 · 8082는 Prometheus만 · 8081은 허용한 pod만" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#B91C1C;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="656" y="448.0" width="416" height="20" as="geometry"/></mxCell><mxCell id="app" value="" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=4;fillColor=#F5F3FF;strokeColor=#8B5CF6;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="690" y="188" width="374" height="246.0" as="geometry"/></mxCell><mxCell id="app-title" value="앱" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=17;fontColor=#4C1D95;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="706" y="200" width="60" height="24" as="geometry"/></mxCell><mxCell id="authn" value="&lt;b style=&quot;font-size:16px&quot;&gt;헤더로 인증 객체 생성&lt;/b&gt;&lt;br&gt;X-User-Id → 회원 ID&lt;br&gt;X-User-Role → 권한 ROLE_{역할}&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;GatewayUserHeaderFilter · 헤더가 없으면 익명&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="742" y="246.0" width="302" height="88" as="geometry"/></mxCell><mxCell id="authz" value="&lt;b style=&quot;font-size:16px&quot;&gt;@PreAuthorize로 인가&lt;/b&gt;&lt;br&gt;세션 없음 (STATELESS)" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="742" y="358.0" width="302" height="58" as="geometry"/></mxCell><mxCell id="prom" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;/actuator/prometheus&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#F3F3F3;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=14;fontColor=#475569;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="755" y="60" width="150" height="50" as="geometry"/></mxCell><mxCell id="internal" value="&lt;b&gt;허용한 pod&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;내부 API 호출&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#F3F3F3;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=14;fontColor=#475569;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="930" y="60" width="140" height="50" as="geometry"/></mxCell><mxCell id="member" value="" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=4;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="170" y="418" width="430" height="240" as="geometry"/></mxCell><mxCell id="member-title" value="member-app" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=17;fontColor=#92400E;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="190" y="428" width="300" height="24" as="geometry"/></mxCell><mxCell id="jwks" value="&lt;b style=&quot;font-size:16px&quot;&gt;JWKS 공개&lt;/b&gt;&lt;br&gt;/api/v1/members/.well-known/jwks.json" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="190" y="462" width="390" height="60" as="geometry"/></mxCell><mxCell id="login" value="&lt;b style=&quot;font-size:16px&quot;&gt;로그인 · 재발급&lt;/b&gt;&lt;br&gt;로그인하면 refresh token(14일)을 HttpOnly 쿠키로&lt;br&gt;재발급하면 access token(RS256, 15분)을 본문으로&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;POST /api/v1/members/auth/refresh&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="190" y="544" width="390" height="96" as="geometry"/></mxCell><mxCell id="redis" value="" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="640" y="508.0" width="440" height="222.0" as="geometry"/></mxCell><mxCell id="redis-title" value="&lt;b style=&quot;color:#1F2937;font-size:17px&quot;&gt;Redis&lt;/b&gt;&amp;nbsp;&amp;nbsp;refresh token 저장" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="656" y="518.0" width="400" height="24" as="geometry"/></mxCell><mxCell id="redis-desc" value="원문 대신 SHA-256 해시로 저장한다&lt;br&gt;재발급은 Lua 스크립트 하나로 원자적으로 회전한다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#1F2937;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="656" y="548.0" width="408" height="40" as="geometry"/></mxCell><mxCell id="r-rotated" value="&lt;b&gt;처음 쓰는 토큰&lt;/b&gt;&amp;nbsp;&amp;nbsp;새 토큰으로 바꾼다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="656" y="596.0" width="408" height="34" as="geometry"/></mxCell><mxCell id="r-grace" value="&lt;b&gt;회전 뒤 10초 안에 다시 오면&lt;/b&gt;&amp;nbsp;&amp;nbsp;access token만 다시 준다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="656" y="638.0" width="408" height="34" as="geometry"/></mxCell><mxCell id="r-reused" value="&lt;b&gt;10초가 지나 다시 오면&lt;/b&gt;&amp;nbsp;&amp;nbsp;그 회원의 refresh token 모두 폐기·거절" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;align=left;" vertex="1" parent="1"><mxGeometry x="656" y="680.0" width="408" height="34" as="geometry"/></mxCell><mxCell id="browser" value="&lt;b style=&quot;font-size:19px&quot;&gt;브라우저&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="60" width="110" height="670.0" as="geometry"/></mxCell><mxCell id="e-req" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.1358;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="browser" target="step1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-12" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="step1" target="step2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-app" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="step2" target="authn"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-ab" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="authn" target="authz"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-jwks" value="공개 키" style="html=1;rounded=0;strokeColor=#3B82F6;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#1E3A8A;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="jwks" target="step2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-prom" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="prom" target="p8082"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-internal" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="internal" target="p8081"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-token" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.794;entryDx=0;entryDy=0;" edge="1" parent="1" source="login" target="browser"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-redis" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3784;entryDx=0;entryDy=0;" edge="1" parent="1" source="login" target="redis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="p8080" value="8080" style="html=1;rounded=0;fontFamily=Wanted Sans;fontSize=13;fontStyle=1;fillColor=#326CE5;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="666.0" y="279.0" width="48" height="22" as="geometry"/></mxCell><mxCell id="p8082" value="8082" style="html=1;rounded=0;fontFamily=Wanted Sans;fontSize=13;fontStyle=1;fillColor=#326CE5;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="806.0" y="177.0" width="48" height="22" as="geometry"/></mxCell><mxCell id="p8081" value="8081" style="html=1;rounded=0;fontFamily=Wanted Sans;fontSize=13;fontStyle=1;fillColor=#326CE5;strokeColor=none;fontColor=#FFFFFF;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="976.0" y="177.0" width="48" height="22" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;앱은 세션도 토큰 검증도 없이 헤더로 인가만 한다&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=19;fontColor=#065F46;spacing=6;align=center;" vertex="1" parent="1"><mxGeometry x="0" y="766.0" width="1080" height="64" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
