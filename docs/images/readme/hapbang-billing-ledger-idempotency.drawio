<mxfile host="drawio"><diagram id="hapbang-billing-ledger-idempotency" name="원장과 멱등키"><mxGraphModel grid="0" page="0" background="#F3F3F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="HP 원장은 쌓기만 하고, 같은 요청은 한 번만 반영한다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="32" as="geometry"/></mxCell><mxCell id="req" value="&lt;b style=&quot;font-size:16px&quot;&gt;HP 요청&lt;/b&gt;&lt;br&gt;보류·반환·지급·충전 등" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="111" width="180" height="90" as="geometry"/></mxCell><mxCell id="key" value="&lt;b style=&quot;font-size:16px&quot;&gt;① 멱등키 만들기&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B;&quot;&gt;BillingKeys가 요청 내용으로 만든다&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:6px&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569;&quot;&gt;HOLD:{참조 유형}:{참조 ID}&lt;br&gt;RELEASE:{보류 ID}:{반환 요청 ID}&lt;br&gt;PAYOUT:{보류 ID}:{지급 요청 ID}&lt;br&gt;CHARGE:{충전 건 ID}&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="226" y="74" width="300" height="164" as="geometry"/></mxCell><mxCell id="lookup" value="&lt;b style=&quot;font-size:16px&quot;&gt;② 같은 키의 기록 찾기&lt;/b&gt;&lt;br&gt;지갑을 잠근 뒤 조회" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="572" y="111" width="220" height="90" as="geometry"/></mxCell><mxCell id="replay" value="&lt;span style=&quot;font-size:13px;color:#64748B;&quot;&gt;같은 키 · 같은 내용&lt;/span&gt;&lt;br&gt;&lt;b&gt;처음 결과를 다시 돌려줌&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;replayed=true, 잔액은 그대로&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="64" width="230" height="84" as="geometry"/></mxCell><mxCell id="conflict" value="&lt;span style=&quot;font-size:13px;color:#64748B;&quot;&gt;같은 키 · 다른 내용&lt;/span&gt;&lt;br&gt;&lt;b&gt;거절 (409)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;IDEMPOTENCY_KEY_CONFLICT&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="164" width="230" height="84" as="geometry"/></mxCell><mxCell id="e-req-key" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="req" target="key"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-key-lookup" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="key" target="lookup"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-replay" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lookup" target="replay"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="816" y="156"/><mxPoint x="816" y="106.0"/></Array></mxGeometry></mxCell><mxCell id="e-conflict" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="lookup" target="conflict"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="816" y="156"/><mxPoint x="816" y="206.0"/></Array></mxGeometry></mxCell><mxCell id="tx" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=none;strokeColor=#94A3B8;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="294" y="290" width="776" height="172" as="geometry"/></mxCell><mxCell id="tx-label" value="③ 반영: 지갑 잔액과 원장을 한 트랜잭션으로" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=16;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="312" y="302" width="600" height="24" as="geometry"/></mxCell><mxCell id="usecase" value="&lt;b style=&quot;font-size:16px&quot;&gt;LedgerRecordUseCase&lt;/b&gt;&lt;br&gt;잔액을 바꾸는 유일한 경로" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="572" y="346" width="220" height="92" as="geometry"/></mxCell><mxCell id="wallet" value="&lt;b style=&quot;font-size:16px&quot;&gt;지갑 잔액 갱신&lt;/b&gt;&lt;br&gt;원장 합의 캐시" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="314" y="346" width="210" height="92" as="geometry"/></mxCell><mxCell id="ledger" value="&lt;b style=&quot;font-size:16px&quot;&gt;원장에 줄 추가&lt;/b&gt;&lt;br&gt;INSERT만 (append-only)" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="840" y="346" width="210" height="92" as="geometry"/></mxCell><mxCell id="e-first" value="처음 본 키" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="lookup" target="usecase"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-wallet" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="usecase" target="wallet"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-ledger" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="usecase" target="ledger"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="guards-label" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;지키는 장치&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;DB와 테스트가 한 번 더 막는다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="490" width="600" height="24" as="geometry"/></mxCell><mxCell id="g-unique" value="&lt;b style=&quot;font-size:15px&quot;&gt;DB UNIQUE&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569;&quot;&gt;uk_point_ledger_idempotency_key&lt;br&gt;uk_point_hold_idempotency_key&lt;/span&gt;&lt;br&gt;같은 키는 동시에 와도 한 행만" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="526" width="334.0" height="104" as="geometry"/></mxCell><mxCell id="g-arch" value="&lt;b style=&quot;font-size:15px&quot;&gt;아키텍처 테스트&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569;&quot;&gt;WalletApplyLedgerAccessTest&lt;/span&gt;&lt;br&gt;잔액 변경(applyLedger) 호출은&lt;br&gt;LedgerRecordUseCase에서만" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="368.0" y="526" width="334.0" height="104" as="geometry"/></mxCell><mxCell id="g-trigger" value="&lt;b style=&quot;font-size:15px&quot;&gt;DB 트리거&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569;&quot;&gt;trg_point_ledger_append_only&lt;/span&gt;&lt;br&gt;원장 UPDATE·DELETE 거부&lt;br&gt;정정은 역분개 INSERT로" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="736.0" y="526" width="334.0" height="104" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
