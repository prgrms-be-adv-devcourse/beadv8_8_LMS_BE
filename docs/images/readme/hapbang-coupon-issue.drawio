<mxfile host="drawio"><diagram id="hapbang-coupon-issue" name="선착순 발급"><mxGraphModel grid="0" page="0" background="#F3F3F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="선착순 발급: Redis Lua로 접수하고 Kafka로 확정한다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="760" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="강의 앱(lecture-app) 안의 쿠폰 모듈" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="36" width="500" height="20" as="geometry"/></mxCell><mxCell id="member" value="&lt;b style=&quot;font-size:19px&quot;&gt;회원&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=10;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=2;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="76" width="100" height="356" as="geometry"/></mxCell><mxCell id="s1" value="&lt;b style=&quot;font-size:16px&quot;&gt;① 발급 요청&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px&quot;&gt;POST /api/v1/coupons/&lt;br&gt;{couponId}/issue-requests&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;본문: 회원이 만든 요청 ID&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="136" y="76" width="200" height="112" as="geometry"/></mxCell><mxCell id="s2" value="&lt;b style=&quot;font-size:16px&quot;&gt;② 매진 빠른 경로&lt;/b&gt;&lt;br&gt;매진 표시가 있으면&lt;br&gt;Spring Security 앞에서&lt;br&gt;바로 409" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="372" y="76" width="180" height="112" as="geometry"/></mxCell><mxCell id="s3" value="&lt;b style=&quot;font-size:16px&quot;&gt;③ Redis Lua 접수&lt;/b&gt;&lt;br&gt;재고 차감 · 회원 중복 검사 ·&lt;br&gt;접수 기록을 원자적으로&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;coupon:{id}:requests (HASH)&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="588" y="76" width="220" height="112" as="geometry"/></mxCell><mxCell id="s4" value="&lt;b style=&quot;font-size:16px&quot;&gt;④ Kafka&lt;/b&gt;&lt;br&gt;coupon.events.v1&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;key = 쿠폰 ID&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="884" y="76" width="150" height="112" as="geometry"/></mxCell><mxCell id="e-m1" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.1573;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="member" target="s1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-12" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s1" target="s2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-23" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="s3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-34" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="s4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-34-label" value="접수 직후&lt;br&gt;전송" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#475569;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="808" y="88.0" width="76" height="36" as="geometry"/></mxCell><mxCell id="r-409" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=0.1778;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.3933;entryDx=0;entryDy=0;" edge="1" parent="1" source="s2" target="member"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="404" y="216"/></Array></mxGeometry></mxCell><mxCell id="r-409-label" value="409 매진" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="114" y="194" width="120" height="18" as="geometry"/></mxCell><mxCell id="r-202" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.1455;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.4888;entryDx=0;entryDy=0;" edge="1" parent="1" source="s3" target="member"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="620" y="250"/></Array></mxGeometry></mxCell><mxCell id="r-202-label" value="&lt;b&gt;202 + 요청 ID&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#475569;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="416" y="228" width="160" height="18" as="geometry"/></mxCell><mxCell id="r-202-note" value="Kafka ACK를 기다리지 않고 응답" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="416" y="256" width="200" height="18" as="geometry"/></mxCell><mxCell id="s5" value="&lt;b style=&quot;font-size:16px&quot;&gt;⑤ 발급 확정&lt;/b&gt;&lt;br&gt;소비자가 한 트랜잭션으로 발급 쿠폰과 발급 결과를 저장" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;verticalAlign=top;spacingTop=10;" vertex="1" parent="1"><mxGeometry x="588" y="290" width="446" height="142" as="geometry"/></mxCell><mxCell id="s5-unique" value="&lt;b style=&quot;font-size:14px&quot;&gt;DB 최종 방어선 · UNIQUE&lt;/b&gt;&lt;br&gt;(member_id, coupon_id) · (coupon_id, issue_request_id)&lt;br&gt;processed_operation (operation_id)" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.25;fontSize=13;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="608" y="352" width="406" height="62" as="geometry"/></mxCell><mxCell id="e-45" value="구독" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.8318;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="s4" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="s6" value="&lt;b style=&quot;font-size:16px&quot;&gt;⑥ 결과 조회 (폴링)&lt;/b&gt;&lt;br&gt;GET …/issue-requests/{요청 ID}&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#64748B&quot;&gt;ISSUED · REJECTED · PENDING&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="136" y="313" width="300" height="96" as="geometry"/></mxCell><mxCell id="e-m6" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.8006;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="member" target="s6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-65" value="DB 결과" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="s6" target="s5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rec-head" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;장애 복구 경로&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;전송 실패 · Redis 재시작 · 확정 실패" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="466" width="600" height="24" as="geometry"/></mxCell><mxCell id="a0" value="&lt;b style=&quot;font-size:14px&quot;&gt;③→④ 전송 실패&lt;/b&gt;&lt;br&gt;응답은 그대로 202" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.25;fontSize=13;fontColor=#C2410C;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="502" width="172" height="62" as="geometry"/></mxCell><mxCell id="a1" value="&lt;b style=&quot;font-size:14px;color:#1F2937&quot;&gt;재발행 배치&lt;/b&gt;&lt;br&gt;DB 결과가 없는 접수 기록을&lt;br&gt;같은 요청 ID로 다시 보냄" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=13;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="208" y="502" width="224" height="62" as="geometry"/></mxCell><mxCell id="a2" value="&lt;b style=&quot;font-size:14px;color:#1F2937&quot;&gt;④ → ⑤ 다시 확정&lt;/b&gt;&lt;br&gt;중복은 소비 멱등이 거름" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=13;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="468" y="502" width="196" height="62" as="geometry"/></mxCell><mxCell id="la1" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a0" target="a1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="la2" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1" target="a2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="a-note" value="Redis 접수 기록이 outbox 역할을 한다.&lt;br&gt;Modulith outbox는 쓰지 않는다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="502" width="334" height="62" as="geometry"/></mxCell><mxCell id="b0" value="&lt;b style=&quot;font-size:14px&quot;&gt;Redis 재시작&lt;/b&gt;&lt;br&gt;접수 기록 일부가&lt;br&gt;사라졌을 수 있음" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.25;fontSize=13;fontColor=#C2410C;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="578" width="172" height="62" as="geometry"/></mxCell><mxCell id="b1" value="&lt;b style=&quot;font-size:14px;color:#1F2937&quot;&gt;run_id 변경 감지&lt;/b&gt;&lt;br&gt;Redis 프로세스 점검 배치" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=13;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="208" y="578" width="224" height="62" as="geometry"/></mxCell><mxCell id="b2" value="&lt;b style=&quot;font-size:14px;color:#1F2937&quot;&gt;신규 접수 차단&lt;/b&gt;&lt;br&gt;hold=RECOVERY" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=13;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="468" y="578" width="196" height="62" as="geometry"/></mxCell><mxCell id="b3" value="&lt;b style=&quot;font-size:14px;color:#1F2937&quot;&gt;관리자 복구 5단계&lt;/b&gt;&lt;br&gt;시작 → 경계 확정 → 결과 확인 → 재구축 → 재개" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=13;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="700" y="578" width="334" height="62" as="geometry"/></mxCell><mxCell id="lb1" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b0" target="b1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lb2" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1" target="b2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lb3" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2" target="b3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c0" value="&lt;b style=&quot;font-size:14px&quot;&gt;⑤ 확정 실패&lt;/b&gt;&lt;br&gt;제한 재시도 뒤에도 실패" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFF7ED;strokeColor=#C2410C;strokeWidth=1.25;fontSize=13;fontColor=#C2410C;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="654" width="172" height="62" as="geometry"/></mxCell><mxCell id="c1" value="&lt;b style=&quot;font-size:14px;color:#1F2937&quot;&gt;DLT 격리&lt;/b&gt;&lt;br&gt;격리 기록 coupon_dlt_log" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=13;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="208" y="654" width="224" height="62" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b style=&quot;font-size:14px;color:#1F2937&quot;&gt;관리자 처리&lt;/b&gt;&lt;br&gt;재발행 또는 영구 거절" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=13;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="468" y="654" width="196" height="62" as="geometry"/></mxCell><mxCell id="lc1" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c0" target="c1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lc2" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="c1" target="c2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c-note" value="재발행: 같은 요청을 원 토픽으로 다시 보냄&lt;br&gt;영구 거절: REJECTED 확정 뒤 Redis 재고를 되돌림" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="700" y="654" width="334" height="62" as="geometry"/></mxCell><mxCell id="result" value="&lt;b&gt;로컬 1,000명 × 재고 100장: 과발급·중복 0, 2.3초 안에 모두 확정&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=19;fontColor=#065F46;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="744" width="1034" height="56" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
