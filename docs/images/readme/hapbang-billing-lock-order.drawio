<mxfile host="drawio"><diagram id="hapbang-billing-lock-order" name="잠금 순서와 잔액 대사"><mxGraphModel grid="0" page="0" background="#F3F3F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="교착 없는 잠금 순서와 매일 잔액 대사" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="32" as="geometry"/></mxCell><mxCell id="subtitle" value="플랫폼 쿠폰이 걸린 지급·보류는 회원 지갑과 프로모션 지갑을 함께 잠근다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=15;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="36" width="900" height="22" as="geometry"/></mxCell><mxCell id="b-head" value="초안: 지갑 유형별 고정 순서" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="84" width="500" height="28" as="geometry"/></mxCell><mxCell id="b-sub" value="계약 초안의 ‘구매자 지갑 → 프로모션 지갑’ 순서. 자체 리뷰에서 버렸다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="114" width="500" height="20" as="geometry"/></mxCell><mxCell id="a-head" value="구현: 지갑 ID 오름차순" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=18;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="84" width="500" height="28" as="geometry"/></mxCell><mxCell id="a-sub" value="어느 흐름이든 관련 지갑을 ID가 작은 것부터 잠근다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="570" y="114" width="500" height="20" as="geometry"/></mxCell><mxCell id="h-b1" value="판매자 X 지급" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=17;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="152" width="220" height="26" as="geometry"/></mxCell><mxCell id="h-b2" value="X의 구매 보류" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=17;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="152" width="220" height="26" as="geometry"/></mxCell><mxCell id="h-a1" value="판매자 X 지급" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=17;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="570" y="152" width="220" height="26" as="geometry"/></mxCell><mxCell id="h-a2" value="X의 구매 보류" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=17;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="850" y="152" width="220" height="26" as="geometry"/></mxCell><mxCell id="life-b1" value="" style="html=1;rounded=0;strokeColor=#CBD5E1;strokeWidth=1.5;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="110.0" y="182" as="sourcePoint"/><mxPoint x="110.0" y="462" as="targetPoint"/></mxGeometry></mxCell><mxCell id="life-b2" value="" style="html=1;rounded=0;strokeColor=#CBD5E1;strokeWidth=1.5;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390.0" y="182" as="sourcePoint"/><mxPoint x="390.0" y="462" as="targetPoint"/></mxGeometry></mxCell><mxCell id="life-a1" value="" style="html=1;rounded=0;strokeColor=#CBD5E1;strokeWidth=1.5;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="680.0" y="182" as="sourcePoint"/><mxPoint x="680.0" y="462" as="targetPoint"/></mxGeometry></mxCell><mxCell id="life-a2" value="" style="html=1;rounded=0;strokeColor=#CBD5E1;strokeWidth=1.5;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960.0" y="182" as="sourcePoint"/><mxPoint x="960.0" y="462" as="targetPoint"/></mxGeometry></mxCell><mxCell id="divider" value="" style="html=1;rounded=0;strokeColor=#CBD5E1;strokeWidth=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="535.0" y="84" as="sourcePoint"/><mxPoint x="535.0" y="534" as="targetPoint"/></mxGeometry></mxCell><mxCell id="b1-1" value="&lt;b&gt;프로모션 지갑&lt;/b&gt; 잠금" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=16;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="192" width="220" height="50" as="geometry"/></mxCell><mxCell id="b2-1" value="&lt;b&gt;X 지갑&lt;/b&gt; 잠금" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=16;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="192" width="220" height="50" as="geometry"/></mxCell><mxCell id="b1-2" value="&lt;b&gt;X 지갑&lt;/b&gt; 잠금 요청" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=16;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="258" width="220" height="50" as="geometry"/></mxCell><mxCell id="b2-2" value="&lt;b&gt;프로모션 지갑&lt;/b&gt; 잠금 요청" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=16;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="280" y="258" width="220" height="50" as="geometry"/></mxCell><mxCell id="b1-w" value="대기&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;X 지갑은 오른쪽이 쥐고 있음&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=16;fontColor=#64748B;spacing=6;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="0" y="324" width="220" height="116" as="geometry"/></mxCell><mxCell id="b2-w" value="대기&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;프로모션 지갑은 왼쪽이 쥐고 있음&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=16;fontColor=#64748B;spacing=6;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="280" y="324" width="220" height="116" as="geometry"/></mxCell><mxCell id="x-b1" value="" style="html=1;rounded=0;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b1-2" target="b2-1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="x-b2" value="" style="html=1;rounded=0;strokeColor=#DC2626;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="b2-2" target="b1-1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="b-result" value="&lt;b&gt;교착: 서로 상대가 쥔 지갑을 기다림&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=2;fontSize=20;fontColor=#B91C1C;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="470" width="500" height="64" as="geometry"/></mxCell><mxCell id="a1-1" value="&lt;b&gt;지갑 잠금&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;ID 오름차순 PESSIMISTIC_WRITE&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=16;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="192" width="220" height="50" as="geometry"/></mxCell><mxCell id="a2-1" value="&lt;b&gt;지갑 잠금 요청&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;같은 ID 순서&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontSize=16;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="192" width="220" height="50" as="geometry"/></mxCell><mxCell id="a1-2" value="&lt;b&gt;보류 → 충전 건&lt;/b&gt; 잠금, 지급" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=16;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="258" width="220" height="50" as="geometry"/></mxCell><mxCell id="a1-3" value="COMMIT, 잠금 해제" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=16;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="324" width="220" height="50" as="geometry"/></mxCell><mxCell id="a2-w" value="대기&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;쥔 지갑 없이 최대 3초&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#F1F5F9;strokeColor=#94A3B8;strokeWidth=1.5;fontSize=16;fontColor=#64748B;spacing=6;dashed=1;dashPattern=5 4;" vertex="1" parent="1"><mxGeometry x="850" y="258" width="220" height="116" as="geometry"/></mxCell><mxCell id="a2-4" value="잠금 획득, 보류" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=16;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="850" y="390" width="220" height="50" as="geometry"/></mxCell><mxCell id="a-handoff" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a1-3" target="a2-4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="820.0" y="349.0"/><mxPoint x="820.0" y="415.0"/></Array></mxGeometry></mxCell><mxCell id="a-result" value="&lt;b&gt;교착 없음: 뒤에 온 쪽이 기다렸다 진행&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=20;fontColor=#065F46;spacing=6;" vertex="1" parent="1"><mxGeometry x="570" y="470" width="500" height="64" as="geometry"/></mxCell><mxCell id="lock-note" value="잠금 순서는 지갑(ID 오름차순) → 보류 → 충전 건. 잠그기 전에 flush, 잠근 뒤 refresh로 최신 잔액을 읽는다. 3초 안에 못 잡으면 롤백하고 HP_LOCK_TIMEOUT(503)으로 답한다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="548" width="1070" height="22" as="geometry"/></mxCell><mxCell id="strip-divider" value="" style="html=1;rounded=0;strokeColor=#CBD5E1;strokeWidth=1;endArrow=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="0" y="598" as="sourcePoint"/><mxPoint x="1070" y="598" as="targetPoint"/></mxGeometry></mxCell><mxCell id="strip-head" value="&lt;b style=&quot;font-size:18px;color:#1F2937&quot;&gt;매일 잔액 대사&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;지갑 잔액(캐시)이 원장 합과 같은지 확인한다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="616" width="800" height="28" as="geometry"/></mxCell><mxCell id="r-cron" value="&lt;b style=&quot;font-size:15px&quot;&gt;매일 04:02:45 KST&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;실행 락을 잡은 pod 하나만&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0.0" y="660" width="186.8" height="96" as="geometry"/></mxCell><mxCell id="r-target" value="&lt;b style=&quot;font-size:15px&quot;&gt;대상 지갑&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;72시간 안에 바뀐 지갑&lt;br&gt;+ 지난 회차 실패 지갑&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="220.8" y="660" width="186.8" height="96" as="geometry"/></mxCell><mxCell id="r-compare" value="&lt;b style=&quot;font-size:15px&quot;&gt;지갑 잔액 ↔ 원장 합&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;지갑마다 한 스냅숏&lt;br&gt;(REPEATABLE_READ)&lt;br&gt;불일치는 고치지 않음&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="441.6" y="660" width="186.8" height="96" as="geometry"/></mxCell><mxCell id="r-record" value="&lt;b style=&quot;font-size:15px&quot;&gt;실행 기록 저장&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;결과별 수와&lt;br&gt;불일치·실패 지갑을 DB에&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="662.4000000000001" y="660" width="186.8" height="96" as="geometry"/></mxCell><mxCell id="r-alert" value="&lt;b style=&quot;font-size:15px&quot;&gt;지표 → Grafana alert&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;&quot;&gt;불일치·실패 지갑 수 &amp;gt; 0&lt;br&gt;“지갑 잔액 대사 불일치·실패”&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FEF2F2;strokeColor=#DC2626;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="883.2" y="660" width="186.8" height="96" as="geometry"/></mxCell><mxCell id="e-r0" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-cron" target="r-target"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-r1" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-target" target="r-compare"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-r2" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-compare" target="r-record"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-r3" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-record" target="r-alert"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-carry" value="실패 지갑은 다음 회차 대상으로" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="r-record" target="r-target"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="755.8000000000001" y="786"/><mxPoint x="314.20000000000005" y="786"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>
