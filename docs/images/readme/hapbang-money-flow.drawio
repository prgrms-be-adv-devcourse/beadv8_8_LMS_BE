<mxfile host="drawio"><diagram id="hapbang-money-flow" name="HP 흐름"><mxGraphModel grid="0" page="0" background="#F3F3F3"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="HP가 한 바퀴 도는 흐름" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=20;fontColor=#1F2937;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="500" height="32" as="geometry"/></mxCell><mxCell id="charge" value="&lt;b style=&quot;font-size:16px&quot;&gt;① 충전&lt;/b&gt;&lt;br&gt;TossPayments 테스트 결제&lt;br&gt;1,000원 단위" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="52" width="180" height="88" as="geometry"/></mxCell><mxCell id="charge-cap" value="billing" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=right;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="110" y="144" width="70" height="18" as="geometry"/></mxCell><mxCell id="wallet-charge" value="&lt;b style=&quot;font-size:19px&quot;&gt;충전 HP&lt;/b&gt;&lt;br&gt;&lt;br&gt;환불 가능&lt;br&gt;환전 불가" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=10;fillColor=#EFF6FF;strokeColor=#3B82F6;strokeWidth=2;fontSize=14;fontColor=#1E3A8A;spacing=6;" vertex="1" parent="1"><mxGeometry x="20" y="176" width="140" height="328" as="geometry"/></mxCell><mxCell id="wallet-revenue" value="&lt;b style=&quot;font-size:19px&quot;&gt;수익 HP&lt;/b&gt;&lt;br&gt;&lt;br&gt;환전 가능&lt;br&gt;환불 불가" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=10;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=2;fontSize=14;fontColor=#065F46;spacing=6;" vertex="1" parent="1"><mxGeometry x="930" y="176" width="140" height="328" as="geometry"/></mxCell><mxCell id="lane-appearance" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;출연&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;호스트가 게스트에게" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="178" width="400" height="24" as="geometry"/></mxCell><mxCell id="lane-lecture" value="&lt;b style=&quot;font-size:17px;color:#1F2937&quot;&gt;강의&lt;/b&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;구매자가 판매자에게" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="354" width="400" height="24" as="geometry"/></mxCell><mxCell id="a-hold" value="&lt;b style=&quot;font-size:16px&quot;&gt;② HP 보류&lt;/b&gt;&lt;br&gt;출연 요청 발송,&lt;br&gt;모집글 게시 때" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="270" y="208" width="180" height="96" as="geometry"/></mxCell><mxCell id="a-confirm" value="&lt;b style=&quot;font-size:16px&quot;&gt;③ 출연 확인&lt;/b&gt;&lt;br&gt;방송 예정 일시부터 7일 안&lt;br&gt;호스트가 확인,&lt;br&gt;응답 없으면 자동 확인" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="484" y="208" width="180" height="96" as="geometry"/></mxCell><mxCell id="a-payout" value="&lt;b style=&quot;font-size:16px&quot;&gt;④ 지급&lt;/b&gt;&lt;br&gt;게스트의 수익 HP로" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="698" y="208" width="180" height="96" as="geometry"/></mxCell><mxCell id="a-hold-cap" value="appearance → billing" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="308" width="180" height="18" as="geometry"/></mxCell><mxCell id="a-confirm-cap" value="appearance" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="484" y="308" width="180" height="18" as="geometry"/></mxCell><mxCell id="a-payout-cap" value="billing" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="698" y="308" width="180" height="18" as="geometry"/></mxCell><mxCell id="l-hold" value="&lt;b style=&quot;font-size:16px&quot;&gt;② HP 보류&lt;/b&gt;&lt;br&gt;장바구니 → 주문,&lt;br&gt;주문 항목마다" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="270" y="384" width="180" height="96" as="geometry"/></mxCell><mxCell id="l-confirm" value="&lt;b style=&quot;font-size:16px&quot;&gt;③ 구매 확정&lt;/b&gt;&lt;br&gt;직접 확정·첫 재생·&lt;br&gt;구매일 다음 날부터 7일 경과&lt;br&gt;중 먼저 오는 시점" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#475569;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="484" y="384" width="180" height="96" as="geometry"/></mxCell><mxCell id="l-payout" value="&lt;b style=&quot;font-size:16px&quot;&gt;④ 지급&lt;/b&gt;&lt;br&gt;내용 다름 이의 제기 기간&lt;br&gt;(구매일 다음 날부터 30일) 뒤&lt;br&gt;판매자의 수익 HP로" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="698" y="384" width="180" height="96" as="geometry"/></mxCell><mxCell id="l-hold-cap" value="lecture → billing" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="484" width="180" height="18" as="geometry"/></mxCell><mxCell id="l-confirm-cap" value="lecture" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="484" y="484" width="180" height="18" as="geometry"/></mxCell><mxCell id="l-payout-cap" value="billing" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="698" y="484" width="180" height="18" as="geometry"/></mxCell><mxCell id="x-request" value="&lt;b style=&quot;font-size:16px&quot;&gt;⑤ 환전 신청&lt;/b&gt;&lt;br&gt;신청 금액만큼&lt;br&gt;수익 HP 보류" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="698" y="556" width="180" height="96" as="geometry"/></mxCell><mxCell id="x-approve" value="&lt;b style=&quot;font-size:16px&quot;&gt;⑥ 관리자 승인&lt;/b&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="484" y="556" width="180" height="96" as="geometry"/></mxCell><mxCell id="x-payout" value="&lt;b style=&quot;font-size:16px&quot;&gt;⑦ 환전 송금&lt;/b&gt;&lt;br&gt;정산일(매월 10일)&lt;br&gt;수수료 10% 공제&lt;br&gt;&lt;span style=&quot;color:#64748B&quot;&gt;Mock 은행 가상 송금&lt;/span&gt;" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=1.5;fontSize=14;fontColor=#1F2937;spacing=6;" vertex="1" parent="1"><mxGeometry x="270" y="556" width="180" height="96" as="geometry"/></mxCell><mxCell id="x-request-cap" value="billing" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="698" y="656" width="180" height="18" as="geometry"/></mxCell><mxCell id="x-approve-cap" value="billing" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="484" y="656" width="180" height="18" as="geometry"/></mxCell><mxCell id="x-payout-cap" value="billing" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="270" y="656" width="180" height="18" as="geometry"/></mxCell><mxCell id="refund" value="&lt;b&gt;환불&lt;/b&gt;&lt;br&gt;TossPayments 결제 취소&lt;br&gt;구매 취소와 다름" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;rounded=1;arcSize=12;fillColor=#F3F3F3;strokeColor=#94A3B8;strokeWidth=1.25;fontSize=14;fontColor=#475569;spacing=6;" vertex="1" parent="1"><mxGeometry x="0" y="556" width="180" height="96" as="geometry"/></mxCell><mxCell id="refund-cap" value="billing" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=13;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="656" width="180" height="18" as="geometry"/></mxCell><mxCell id="e-charge" value="" style="html=1;rounded=0;strokeColor=#3B82F6;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="charge" target="wallet-charge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-a-pay" value="HP 결제" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.1951;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="1" source="wallet-charge" target="a-hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-a-23" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a-hold" target="a-confirm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-a-34" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="a-confirm" target="a-payout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-a-rev" value="" style="html=1;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2439;entryDx=0;entryDy=0;" edge="1" parent="1" source="a-payout" target="wallet-revenue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-a" value="반환" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=0;exitY=0.6875;exitDx=0;exitDy=0;entryX=1;entryY=0.2988;entryDx=0;entryDy=0;" edge="1" parent="1" source="a-hold" target="wallet-charge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-l-pay" value="HP 결제" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;fontFamily=Wanted Sans;fontSize=13;fontColor=#475569;labelBackgroundColor=#F3F3F3;exitX=1;exitY=0.7317;exitDx=0;exitDy=0;entryX=0;entryY=0.3333;entryDx=0;entryDy=0;" edge="1" parent="1" source="wallet-charge" target="l-hold"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-l-23" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l-hold" target="l-confirm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-l-34" value="" style="html=1;rounded=0;strokeColor=#475569;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="l-confirm" target="l-payout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-l-rev" value="" style="html=1;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.7805;entryDx=0;entryDy=0;" edge="1" parent="1" source="l-payout" target="wallet-revenue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-l" value="반환" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=0;exitY=0.6875;exitDx=0;exitDy=0;entryX=1;entryY=0.8354;entryDx=0;entryDy=0;" edge="1" parent="1" source="l-hold" target="wallet-charge"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-a-why" value="거절·취소·&lt;br&gt;만료·불참" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="164" y="284" width="102" height="34" as="geometry"/></mxCell><mxCell id="r-l-why" value="구매 취소·&lt;br&gt;이의 제기 인정" style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=center;verticalAlign=middle;spacing=0;fontSize=12;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="164" y="460" width="102" height="34" as="geometry"/></mxCell><mxCell id="e-x-1" value="" style="html=1;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="wallet-revenue" target="x-request"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1000.0" y="604.0"/></Array></mxGeometry></mxCell><mxCell id="e-x-2" value="" style="html=1;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="x-request" target="x-approve"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e-x-3" value="" style="html=1;rounded=0;strokeColor=#059669;strokeWidth=2;endArrow=block;endFill=1;endSize=7;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="x-approve" target="x-payout"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r-refund" value="" style="html=1;rounded=0;strokeColor=#94A3B8;strokeWidth=1.5;endArrow=block;endFill=1;endSize=5;fontFamily=Wanted Sans;fontSize=13;fontColor=#64748B;labelBackgroundColor=#F3F3F3;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="wallet-charge" target="refund"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="note" value="1 HP = 1원. HP 결제는 수익 HP를 먼저 쓰고 모자라면 충전 HP를 쓴다. 반환은 차감했던 HP 종류 그대로 돌려준다." style="html=1;whiteSpace=wrap;fontFamily=Wanted Sans;text;align=left;verticalAlign=middle;spacing=0;fontSize=14;fontColor=#64748B;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="0" y="696" width="1070" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
