{
  "settings": {
    "number_of_shards": 1,
    "number_of_replicas": 0,
    "analysis": {
      "tokenizer": {
        "ko_tokenizer": {
          "type": "nori_tokenizer",
          "decompound_mode": "discard",
          "user_dictionary_rules": "__USER_DICTIONARY__"
        }
      },
      "filter": {
        "ko_synonyms": {
          "type": "synonym_graph",
          "synonyms_set": "__SYNONYMS_SET__",
          "updateable": true
        }
      },
      "analyzer": {
        "ko_index": {
          "type": "custom",
          "tokenizer": "ko_tokenizer",
          "filter": ["nori_part_of_speech", "lowercase"]
        },
        "ko_search": {
          "type": "custom",
          "tokenizer": "ko_tokenizer",
          "filter": ["nori_part_of_speech", "lowercase", "ko_synonyms"]
        },
        "hangul_keys": {
          "type": "custom",
          "tokenizer": "whitespace",
          "filter": ["lowercase"]
        }
      }
    }
  },
  "mappings": {
    "dynamic": "strict",
    "properties": {
      "userId": { "type": "long" },
      "memberVersion": { "type": "long" },
      "hidden": { "type": "boolean" },
      "hiddenAt": { "type": "date" },
      "nickname": {
        "type": "text", "analyzer": "ko_index", "search_analyzer": "ko_search",
        "fields": { "suggest": { "type": "search_as_you_type", "analyzer": "ko_index" } }
      },
      "nicknameChosung": { "type": "search_as_you_type", "analyzer": "hangul_keys" },
      "nicknameJamo": { "type": "search_as_you_type", "analyzer": "hangul_keys" },
      "bio": { "type": "text", "analyzer": "ko_index", "search_analyzer": "ko_search" },
      "role": { "type": "keyword" },
      "verified": { "type": "boolean" },
      "contentCategories": {
        "properties": {
          "code": { "type": "keyword" },
          "name": { "type": "text", "analyzer": "ko_index", "search_analyzer": "ko_search" }
        }
      },
      "channelNames": { "type": "text", "analyzer": "ko_index", "search_analyzer": "ko_search" },
      "representativeChannelName": { "type": "keyword", "index": false },
      "followerCount": { "type": "long" },
      "ratingAverage": { "type": "double" },
      "ratingCount": { "type": "long" }
    }
  }
}
