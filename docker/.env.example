# 로컬 개발용 예시 값. 서버(env/*.env)에는 추측하기 어려운 다른 값을 쓴다.
POSTGRES_DB=hapbang
POSTGRES_USER=example
POSTGRES_PASSWORD=example
POSTGRES_PORT=5432

# edge(compose.edge.yaml)용. 서버에서는 /opt/hapbang/env/edge.env에 둔다.
PROD_HOST=<이름>.duckdns.org
DEV_HOST=dev.<이름>.duckdns.org

# 구글 OAuth (Google Cloud Console > Google Auth Platform > 클라이언트). 서버는 env/*.env에 실제 값
GOOGLE_CLIENT_ID=example
GOOGLE_CLIENT_SECRET=example

# S3 버킷 이름. 서버 env/*.env에만 실제 값을 넣는다(공개 레포라 여기에는 쓰지 않는다).
# 로컬은 S3Mock(docker/compose.yaml)을 쓰므로 필요 없다. 값을 넣으면 로컬도 그 버킷을 찾으니 주석으로 둔다
# S3_BUCKET=<버킷 이름>
# 로컬 S3Mock 포트 (바꾸면 S3_ENDPOINT=http://localhost:<포트>도 함께 지정)
S3MOCK_PORT=9090

# 치지직 채널 인증 (치지직 개발자 센터 > 애플리케이션). 앱마다 리디렉션 URL이 하나라 환경(dev·prod)마다 앱이 따로 있다
# 리디렉션 URL: https://<도메인>/api/v1/members/channels/chzzk/callback
CHZZK_CLIENT_ID=example
CHZZK_CLIENT_SECRET=example
CHZZK_REDIRECT_URI=https://dev.<이름>.duckdns.org/api/v1/members/channels/chzzk/callback

# 모듈 간 내부 HTTP API(/api/v1/internal/**) 키 (#300). 서버 env/*.env에는 추측하기 어려운 긴 값(예: openssl rand -hex 32)을 쓴다.
# 로컬은 application-local.yaml의 기본값을 쓰므로 필요 없다
# HAPBANG_INTERNAL_API_KEY=example
