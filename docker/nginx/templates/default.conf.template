# ${PROD_HOST}, ${DEV_HOST}는 시작 시 치환된다. 나머지 $변수는 nginx 변수다.

# 업스트림 이름을 요청 시점에 Docker DNS로 해석한다.
# 한 스택(예: 개발)이 내려가 있어도 edge는 뜨고, 해당 도메인만 502를 반환한다.
resolver 127.0.0.11 valid=10s ipv6=off;

# 채팅(WebSocket) 업그레이드 요청을 그대로 전달한다.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# 등록되지 않은 Host(IP 직접 접근, 스캐너 등)는 응답 없이 끊는다.
server {
    listen 80 default_server;
    return 444;
}

server {
    listen 443 ssl default_server;
    ssl_reject_handshake on;
}

# HTTP: 인증서 검증 경로만 응답하고 나머지는 HTTPS로 보낸다.
server {
    listen 80;
    server_name ${PROD_HOST} ${DEV_HOST};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${PROD_HOST};
    include /etc/nginx/snippets/ssl.conf;

    set $web_upstream prod-web;
    set $app_upstream prod-app;
    include /etc/nginx/snippets/routes.conf;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${DEV_HOST};
    include /etc/nginx/snippets/ssl.conf;

    set $web_upstream dev-web;
    set $app_upstream dev-app;
    include /etc/nginx/snippets/routes.conf;
}
