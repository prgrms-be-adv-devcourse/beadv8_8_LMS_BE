#!/bin/bash
# EC2를 처음 만들 때 cloud-init이 root로 한 번 실행한다. 로그: /var/log/cloud-init-output.log
# k3s 설치 전 OS 준비만 한다: docs/deploy/aws-k3s.md "k3s 설치" 1단계와 "전환 순서" 4의 sysctl.
# k3s 설치와 agent join은 사람이 한다. join token을 user data와 Terraform state에 남기지 않기 위해서다.
# ec2.tf가 templatefile로 렌더링한다(변수 node: server 또는 agent). 셸 변수를 중괄호로 감싸 쓰면 Terraform 보간이 되니 쓰지 않는다.
set -euxo pipefail

timedatectl set-timezone Asia/Seoul

# node가 꺼질 때 kubelet이 pod를 정리할 시간을 잡는다. 파일 이름이 zz-로 시작하는 이유는 docs/deploy/aws-k3s.md에 있다.
mkdir -p /etc/systemd/logind.conf.d
cat > /etc/systemd/logind.conf.d/zz-hapbang-inhibit-delay.conf <<'CONF'
[Login]
InhibitDelayMaxSec=90
CONF
systemctl kill -s HUP systemd-logind

# k3s가 시작할 때 읽는 kubelet 설정 파일. graceful shutdown은 kubelet CLI 플래그가 없어 kubelet-arg로 넘길 수 없다.
mkdir -p /var/lib/rancher/k3s/agent/etc/kubelet.conf.d
cat > /var/lib/rancher/k3s/agent/etc/kubelet.conf.d/10-graceful-shutdown.conf <<'CONF'
apiVersion: kubelet.config.k8s.io/v1beta1
kind: KubeletConfiguration
shutdownGracePeriod: 60s
shutdownGracePeriodCriticalPods: 20s
CONF
%{ if node == "server" ~}

# Elasticsearch(core-data node)가 요구한다. ES 9 권장값이다.
cat > /etc/sysctl.d/99-hapbang-elasticsearch.conf <<'CONF'
vm.max_map_count=1048576
CONF
sysctl --system
%{ endif ~}
